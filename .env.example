POSTGRES_USER=emotepurge
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Twitch-Logins mit Zugang zum Admin-Bereich (/admin/*), kommagetrennt, ohne Leerzeichen-Zwang.
# Trag hier deinen eigenen Login ein — sonst liefert der Admin-Bereich ein blankes 403.
ADMIN_TWITCH_LOGINS=
# 32-Byte-Schlüssel (base64) für die Verschlüsselung der Twitch-Tokens in Postgres.
# Erzeugen z. B. mit: openssl rand -base64 32
AUTH_TWITCH_TOKEN_ENCRYPTION_KEY=
# 7TV-EventAPI-Live-Updates (WebSocket) im Worker; false = nur periodischer REST-Resync.
SEVENTV_EVENTAPI_ENABLED=false
# Takt des periodischen 7TV-Vollsyncs; bei aktivem WebSocket auf z. B. 300 streckbar.
SEVENTV_RESYNC_INTERVAL_SECONDS=60
# Takt des Helix-Live-Polls im Worker (GET /helix/streams, App-Access-Token) für die
# Live-Abdeckung pro Tag (A10). Ein Poll, der einen Channel live sieht, schreibt dem Tag
# genau diese Intervalllänge als Live-Minuten gut.
TWITCH_LIVE_POLL_INTERVAL_SECONDS=300
# Channel-eigene Bots, die in keiner Fremdliste stehen (kommagetrennte Twitch-User-IDs, keine
# Logins). Ergänzt nur die eingebaute statische Liste bekannter Bots (nightbot, streamelements,
# fossabot, moobot, streamlabs, sery_bot) — ersetzt sie nicht, leer ist der Normalfall.
TWITCH_ADDITIONAL_BOT_ACCOUNT_IDS=
# Byte-Decke je Harness-Lauf (#69), in Megabyte. Fremdlast auf einen fremden Log-Dienst: 30 Tage
# eines großen Kanals sind rund 490 MB, ein kleiner Kanal bleibt deutlich darunter. Erst einen
# kleinen Kanal probieren; ein am Limit abgebrochener Lauf liefert Wiederaufnahmepunkt und
# Kennzahlen, aber keine Replay-Treue für das volle Fenster.
HARNESS_MAX_MEGABYTES_PER_RUN=200
# UTC-Tag (ISO yyyy-MM-dd) nach dem Prod-Deploy von #73 (D+1), ab dem Nachrichten aus Shared-Chat
# nicht mehr in der eigenen Nutzung landen. Ohne diesen Wert bricht ein bindender Harness-Lauf mit
# Exit 3 ab, bevor er Datenbank oder Log-Archiv berührt (fail-closed, D4) — leer heißt: nur
# `--diagnostic` läuft, ein Lauf ohne Gate-Urteil. Nach einem Rollback des Worker-Images im
# Messfenster neu auf den Tag nach dem erneuten Deploy setzen.
HARNESS_SHARED_CHAT_CUTOVER=
# Vor dem allerersten Harness-Lauf einmalig anlegen (lokal wie auf dem VPS) — ohne diesen Schritt
# legt Docker das fehlende Bind-Mount-Ziel als root:root an, das Image läuft aber als appuser mit
# fest vergebenem uid/gid 999 (s. src/EmotePurge.Worker/Dockerfile), und der erste Lauf scheitert
# mit "Permission denied" (#69 Task 8a):
#   mkdir -p harness-reports && sudo chown 999:999 harness-reports
# Lokaler Aufruf danach immer mit --build: der Dienst hat ein eigenes `build:` ohne `image:`,
# und `docker compose run` ohne `--build` führt klaglos ein vorhandenes, potenziell uraltes Image
# weiter (Regel 15).
#   docker compose --profile harness run --build --rm harness <kanal>
# Ohne gesetzten Stichtag oben nur diagnostisch, ohne Gate-Urteil:
#   docker compose --profile harness run --build --rm harness <kanal> --diagnostic
