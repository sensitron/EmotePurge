POSTGRES_USER=emotepurge
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Twitch-Logins mit Zugang zum Admin-Bereich (/admin/*), kommagetrennt, ohne Leerzeichen-Zwang.
# Trag hier deinen eigenen Login ein — sonst liefert der Admin-Bereich ein blankes 403.
ADMIN_TWITCH_LOGINS=
# 32-Byte-Schlüssel (base64) für die Verschlüsselung der Twitch-Tokens in Postgres.
# Erzeugen z. B. mit: openssl rand -base64 32
AUTH_TWITCH_TOKEN_ENCRYPTION_KEY=
# 7TV-EventAPI-Live-Updates (WebSocket) im Worker; false = nur periodischer REST-Resync.
SEVENTV_EVENTAPI_ENABLED=false
# Takt des periodischen 7TV-Vollsyncs; bei aktivem WebSocket auf z. B. 300 streckbar.
SEVENTV_RESYNC_INTERVAL_SECONDS=60
